{
  "name": "music-siren-web",
  "version": "0.0.0",
  "private": true,
  "description": "ヤマハ・ミュージックサイレン（第1世代機）の音響・3D シミュレーション。非公式。",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=moderate",
    "check": "pnpm typecheck && pnpm test && pnpm audit"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
